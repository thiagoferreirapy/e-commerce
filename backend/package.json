{
  "name": "torque-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST da loja TORQUE — Express + Prisma + SQLite",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset --force",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.3.1",
    "bcryptjs": "2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "express": "4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "9.0.2",
    "multer": "^2.1.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "22.10.7",
    "prisma": "6.3.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
